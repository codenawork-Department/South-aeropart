{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "South Aero fuzz design corpus",
  "description": "Schema for recipes/test specifications, not an HTTP request schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "th"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "evidence": {
      "type": "object"
    },
    "semantics": {
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "targets": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "cart.add",
          "checkout.create",
          "guest.track",
          "admin.product",
          "inventory.delta",
          "amount.validate",
          "api.json",
          "stripe.webhook",
          "money.convert"
        ]
      }
    },
    "fixtures": {
      "type": "object"
    },
    "assertions": {
      "type": "object"
    },
    "recipeDefinitions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/case"
      }
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "language",
    "generatedAt",
    "evidence",
    "semantics",
    "limits",
    "targets",
    "fixtures",
    "assertions",
    "recipeDefinitions",
    "cases"
  ],
  "definitions": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/jsonValue"
          }
        }
      ]
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "values"
            },
            "operation": {
              "const": "set"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/jsonValue"
              }
            }
          },
          "required": [
            "mode",
            "operation",
            "path",
            "values"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "raw"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "mode",
            "values"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "recipe"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/jsonValue"
              }
            }
          },
          "required": [
            "mode",
            "name",
            "args"
          ]
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[NSTGWA]-[0-9]{2}$"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "cart.add",
              "checkout.create",
              "guest.track",
              "admin.product",
              "inventory.delta",
              "amount.validate",
              "api.json",
              "stripe.webhook",
              "money.convert"
            ]
          },
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "N",
            "S",
            "T",
            "G",
            "W",
            "A"
          ]
        },
        "applicability": {
          "enum": [
            "current_surface",
            "proposed_contract",
            "adapter_required"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/definitions/input"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "semanticStatus": {
              "enum": [
                200,
                400,
                401,
                403,
                404,
                409,
                413,
                415,
                422,
                429,
                500,
                503
              ]
            },
            "httpStatus": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "cart.add",
                  "checkout.create",
                  "guest.track",
                  "admin.product",
                  "inventory.delta",
                  "amount.validate",
                  "api.json",
                  "stripe.webhook",
                  "money.convert"
                ]
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "enum": [
                      200,
                      400,
                      401,
                      403,
                      404,
                      409,
                      413,
                      415,
                      422,
                      429,
                      500,
                      503
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "outcome": {
              "enum": [
                "accept",
                "reject",
                "retry",
                "accept_or_noop_by_variant",
                "one_accept_one_conflict"
              ]
            },
            "errorCode": {
              "type": [
                "string",
                "null"
              ]
            },
            "invariants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "NO_LEAK",
                  "REJECT_NO_EFFECT",
                  "SAFE_ACCEPT",
                  "INTEGER_EXACT",
                  "NO_POLLUTION",
                  "PLAIN_TEXT",
                  "AT_MOST_ONCE",
                  "RESOURCE_BOUNDED",
                  "GUEST_PRIVATE",
                  "AUTHORITATIVE"
                ]
              },
              "uniqueItems": true
            },
            "detail": {
              "type": "string"
            },
            "variantOverrides": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "semanticStatus": {
                    "enum": [
                      200,
                      400,
                      401,
                      403,
                      404,
                      409,
                      413,
                      415,
                      422,
                      429,
                      500,
                      503
                    ]
                  },
                  "wireStatus": {
                    "enum": [
                      200,
                      400,
                      401,
                      403,
                      404,
                      409,
                      413,
                      415,
                      422,
                      429,
                      500,
                      503
                    ]
                  },
                  "errorCode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "semanticStatus",
                  "wireStatus",
                  "errorCode"
                ]
              }
            }
          },
          "required": [
            "semanticStatus",
            "httpStatus",
            "outcome",
            "errorCode",
            "invariants",
            "detail"
          ]
        }
      },
      "required": [
        "id",
        "targets",
        "summary",
        "category",
        "applicability",
        "actor",
        "fixture",
        "input",
        "expected"
      ]
    }
  }
}
