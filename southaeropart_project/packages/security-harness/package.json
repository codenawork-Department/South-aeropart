{
  "name": "@repo/security-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:diagnostics": "vitest run --config vitest.diagnostics.config.ts",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "validate": "tsx src/cli/validate-corpus.ts",
    "manifest": "tsx src/cli/generate-manifest.ts",
    "gate": "tsx src/cli/generate-manifest.ts --strict",
    "native": "tsx src/cli/native.ts",
    "replay": "tsx src/cli/replay.ts"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/lib": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "4.1.11"
  }
}
