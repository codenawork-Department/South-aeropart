{
  "name": "south-aero-platform",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:storefront": "pnpm --filter storefront dev",
    "dev:admin": "pnpm --filter admin dev",
    "clean": "pnpm dlx rimraf apps/storefront/.next apps/admin/.next .turbo",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:push": "pnpm --filter @repo/db push",
    "db:studio": "pnpm --filter @repo/db studio",
    "tunnel:storefront": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:admin": "cloudflared tunnel --url http://localhost:3001",
    "verify": "pnpm --filter storefront verify",
    "verify:stripe": "pnpm --filter storefront verify:stripe",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:stateful": "node scripts/run-stateful-e2e.mjs",
    "test:security": "pnpm --filter e2e test:security"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=22.17.0 <25"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "js-cookie": "^3.0.7",
      "esbuild": "^0.25.0",
      "js-yaml@^4": "^4.3.2"
    }
  }
}
