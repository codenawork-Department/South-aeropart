{
  "mcpServers": {
    "neon-postgres": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "if not defined DATABASE_URL (exit /b 1) else (npx -y @modelcontextprotocol/server-postgres \"%DATABASE_URL%\")"
      ]
    },
    "puppeteer": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "fetch": {
      "command": "python",
      "args": [
        "-m",
        "mcp_server_fetch"
      ]
    },
    "memory": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    }
  }
}
